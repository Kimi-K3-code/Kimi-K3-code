from ._core import ask
async def generate_text(context: ProviderContext) -> FacadeResult:
    prompt = context.payload["messages"][-1]["content"]
    res = await asyncio.to_thread(ask, model=context.model, prompt=prompt)
    return FacadeResult(succeeded=True, output={"text": res["text"], "finish_reason": "stop"})
async def analyze_vision(context: ProviderContext) -> FacadeResult:
    # حماية الموديل: لو مش بيدعم صور نرجع unsupported_capability
    if not is_vision_model(context.model):
        return make_error(ErrorCategory.UNSUPPORTED_CAPABILITY, "This model does not support images")
        
    res = await asyncio.to_thread(
        ask, 
        model=context.model, 
        prompt=context.payload["instruction"], 
        image_b64=context.payload["image_b64"], 
        image_format=context.payload["image_format"]
    )
    return FacadeResult(succeeded=True, output={"text": res["text"]})
